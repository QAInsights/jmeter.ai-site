---
import { challengeDays, challengeMeta } from "../data/challenge";

const phases = challengeMeta.phases.map((phase) => ({
  ...phase,
  days: challengeDays.filter((day) => day.phase === phase.key),
}));
---

<section class="space-y-8">
  <div class="space-y-3">
    <p class="text-xs font-mono tracking-widest text-violet-300 uppercase">🏆 30-Day Challenge</p>
    <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">
      {challengeMeta.heading} <span class="text-violet-400">{challengeMeta.highlight}</span>
    </h2>
    <p class="text-slate-400 text-sm max-w-3xl leading-relaxed">{challengeMeta.description}</p>
    <p class="text-slate-400 text-sm max-w-3xl leading-relaxed">{challengeMeta.subdescription}</p>
    <a href="/challenge/" class="inline-flex items-center gap-2 text-xs font-mono text-violet-300 hover:text-violet-200 transition">
      Browse all 30 days with shareable pages →
    </a>
  </div>

  <div class="space-y-4">
    {
      phases.map((phase) => (
        <details class="glass-panel rounded-xl border border-white/10 group">
          <summary class="flex flex-wrap items-center gap-3 px-5 py-4 cursor-pointer list-none select-none">
            <span class="text-xl" aria-hidden="true">{phase.emoji}</span>
            <span class="font-bold text-white">{phase.label}</span>
            <span class="text-xs font-mono text-violet-300">{phase.range}</span>
            <span class="ml-auto text-xs font-mono text-slate-500">
              {phase.days.length} days
              <span class="inline-block ml-2 transition-transform group-open:rotate-90" aria-hidden="true">▶</span>
            </span>
          </summary>
          <div class="border-t border-white/5 divide-y divide-white/5">
            {phase.days.map((day) => (
              <details class="group/day">
                <summary class="flex items-center gap-3 px-5 py-3 cursor-pointer list-none select-none hover:bg-white/5 transition">
                  <span class="shrink-0 w-8 text-xs font-mono text-violet-300">D{day.day}</span>
                  <span aria-hidden="true">{day.emoji}</span>
                  <span class="text-sm font-semibold text-slate-200">{day.title}</span>
                  <a
                    href={`/challenge/day-${day.day}/`}
                    class="ml-auto text-[10px] font-mono text-violet-300 hover:text-violet-200 transition"
                    onclick="event.stopPropagation()"
                  >permalink ↗</a>
                  <span class="text-slate-500 text-xs transition-transform group-open/day:rotate-90" aria-hidden="true">▶</span>
                </summary>
                <div class="px-5 pb-5 pl-16 space-y-3 text-sm">
                  <p class="text-slate-300"><span class="font-semibold text-white">Objective: </span>{day.objective}</p>
                  <p class="text-slate-400 leading-relaxed">{day.scenario}</p>
                  <div class="flex flex-wrap gap-1.5">
                    {day.metrics.map((metric) => (
                      <span class="px-2 py-0.5 rounded bg-violet-500/10 text-violet-300 text-[10px] font-mono">
                        {metric}
                      </span>
                    ))}
                  </div>
                  <p class="text-slate-300"><span class="font-semibold text-violet-300">When it clicks: </span>{day.aha}</p>
                  <p class="text-slate-400"><span class="font-semibold text-white">Reflection: </span>{day.reflection}</p>
                  <p class="text-slate-400"><span class="font-semibold text-white">Deliverable: </span>{day.deliverable}</p>
                  <details class="group/solution">
                    <summary class="text-xs font-mono text-violet-300 cursor-pointer list-none select-none hover:text-violet-200">
                      ▶ Show solution
                    </summary>
                    <p class="mt-2 text-slate-400 text-xs leading-relaxed bg-black/40 rounded-lg border border-white/5 p-4">
                      {day.solution}
                    </p>
                  </details>
                </div>
              </details>
            ))}
          </div>
        </details>
      ))
    }
  </div>

  <p class="text-xs text-amber-400/80 font-mono leading-relaxed max-w-3xl">⚠️ {challengeMeta.disclaimer}</p>
</section>

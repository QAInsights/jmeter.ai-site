---
import { siteConfig, products } from "../data/products";
import type { Product } from "../data/products";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** When set, emit only this product's SoftwareApplication schema + breadcrumbs instead of all products. */
  product?: Product;
  /** Extra schema.org nodes appended to the JSON-LD @graph. */
  jsonLdExtra?: Record<string, unknown>[];
}

const { title = siteConfig.title, description = siteConfig.description, image = "/og.png", product, jsonLdExtra = [] } = Astro.props;
const fullTitle = title === siteConfig.title ? `${title} | AI-Powered Tools for Apache JMeter` : `${title} | ${siteConfig.title}`;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://jmeter.ai";
const _rawUrl = new URL(Astro.url?.pathname ?? "/", siteUrl + "/");
_rawUrl.search = "";
_rawUrl.hash = "";
const pageUrl = _rawUrl.toString();
const ogImageUrl = image.startsWith("http") ? image : `${siteUrl}${image}`;

const isSettingsPage = Astro.url?.pathname === '/settings/' || Astro.url?.pathname === '/settings';

const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? "G-7WS8LF9649";

const productSchema = (p: Product) => ({
  "@type": "SoftwareApplication",
  "@id": `${siteConfig.url}/#${p.id}`,
  name: p.name,
  description: p.description,
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "Performance Testing",
  operatingSystem: "Windows, macOS, Linux",
  url: `${siteConfig.url}/products/${p.id}/`,
  downloadUrl: `${p.github}/releases`,
  installUrl: `${siteConfig.url}/products/${p.id}/`,
  ...(p.features.length > 0 ? { featureList: p.features.map((f) => f.title) } : {}),
  author: { "@id": `${siteConfig.url}/#organization` },
  publisher: { "@id": `${siteConfig.url}/#organization` },
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
  },
  isPartOf: { "@id": `${siteConfig.url}/#website` },
});

const faqSchema = (p: Product) =>
  p.faqs && p.faqs.length > 0
    ? [{
        "@type": "FAQPage",
        "@id": `${siteConfig.url}/products/${p.id}/#faq`,
        mainEntity: p.faqs.map((f) => ({
          "@type": "Question",
          name: f.question,
          acceptedAnswer: { "@type": "Answer", text: f.answer },
        })),
        isPartOf: { "@id": `${siteConfig.url}/#website` },
      }]
    : [];

const breadcrumbSchema = product
  ? [{
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.url },
        { "@type": "ListItem", position: 2, name: "Products", item: `${siteConfig.url}/#products` },
        { "@type": "ListItem", position: 3, name: product.name, item: `${siteConfig.url}/products/${product.id}/` },
      ],
    }]
  : [];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteConfig.url}/#website`,
      name: siteConfig.title,
      url: siteConfig.url,
      description: siteConfig.description,
      inLanguage: "en-US",
      publisher: { "@id": `${siteConfig.url}/#organization` },
    },
    ...(isSettingsPage ? [{
      "@type": "WebPage",
      "@id": `${siteConfig.url}/settings/#webpage`,
      name: "Settings | JMeter.AI",
      url: `${siteConfig.url}/settings/`,
      description: "User account settings and profile management for JMeter.AI",
      inLanguage: "en-US",
      isPartOf: { "@id": `${siteConfig.url}/#website` },
    }] : []),
    {
      "@type": "Organization",
      "@id": `${siteConfig.url}/#organization`,
      name: "QAInsights",
      alternateName: "JMeter.AI",
      url: siteConfig.authorUrl,
      logo: {
        "@type": "ImageObject",
        url: `${siteConfig.url}/favicon.svg`,
        width: 512,
        height: 512,
      },
      founder: {
        "@type": "Person",
        name: siteConfig.author,
        url: siteConfig.authorUrl,
      },
      sameAs: [
        "https://github.com/QAInsights",
        "https://twitter.com/QAInsights",
        "https://youtube.com/@QAInsights",
        "https://linkedin.com/in/naveenkumarn",
        "https://qainsights.com",
      ],
    },
    ...(product ? [productSchema(product)] : products.map(productSchema)),
    ...(product ? faqSchema(product) : []),
    ...breadcrumbSchema,
    ...jsonLdExtra,
  ],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={siteConfig.author} />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content={isSettingsPage ? "noindex, nofollow" : "index, follow"} />

<!-- RSS autodiscovery -->
<link rel="alternate" type="application/rss+xml" title="JMeter.AI" href={`${siteUrl}/rss.xml`} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={pageUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:site" content="@QAInsights" />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Favicon -->
<link rel="manifest" href="/site.webmanifest" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="JMeter.AI" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="mobile-web-app-capable" content="yes" />

<!-- Fonts: non-render-blocking load -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" />
<link rel="stylesheet" media="print" onload="this.media='all'" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" />
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" /></noscript>
<!-- Preconnect for YouTube embeds -->
<link rel="preconnect" href="https://www.youtube-nocookie.com" />
<link rel="dns-prefetch" href="https://www.youtube.com" />

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<!-- Google Analytics 4 (gtag.js) -->
{gaMeasurementId && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
    <script is:inline define:vars={{ gaMeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaMeasurementId);
    </script>
  </>
)}

<!-- Theme color -->
<meta name="theme-color" content="#090a0f" />
<meta name="msapplication-TileColor" content="#090a0f" />
<meta name="color-scheme" content="dark" />

<!-- Canonical -->
<link rel="canonical" href={pageUrl} />

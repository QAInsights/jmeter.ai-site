---
const navLinks = [
  { href: "/#products", label: "Products", event: "products" },
  { href: "/#architecture", label: "Architecture", event: "architecture" },
  { href: "/#installation", label: "Installation", event: "installation" },
  { href: "/quickstart/", label: "Quickstart", event: "quickstart" },
  { href: "https://docs.jmeter.ai", label: "Docs", external: true, event: "docs" },
  { href: "https://plugins.jmeter.ai", label: "Plugins", external: true, event: "plugins" },
];
---

<header class="sticky top-0 z-50 bg-[#090a0f]/25 border-b border-white/10 px-4 sm:px-6 py-4">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 sm:gap-3">
      <span class="text-xl sm:text-2xl" aria-hidden="true">⚡</span>
      <span class="font-bold text-lg sm:text-xl tracking-tight text-white">JMeter<span class="text-cyan-400">.AI</span></span>
    </a>

    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-nav-event={link.event}
            class="vf-focus px-2 py-1 -mx-2 hover:text-white transition"
            {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3 sm:gap-4">
      <a
        href="https://github.com/QAInsights/jmeter-ai"
        data-nav-event="github_star"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-3 sm:px-4 py-2 text-xs font-mono font-medium rounded-lg glass-panel hover:bg-white/10 transition border border-white/10 text-slate-200"
      >
        <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
          ></path>
        </svg>
        <span><span class="hidden sm:inline">Star on </span>GitHub</span>
      </a>

      <!-- Mobile menu button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="md:hidden p-2 rounded-lg text-slate-300 hover:text-white hover:bg-white/10 transition border border-white/10"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
      >
        <svg id="hamburger-icon" class="w-5 h-5 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu drawer -->
  <div
    id="mobile-menu"
    class="hidden md:hidden fixed inset-x-0 top-[65px] bg-[#090a0f]/95 backdrop-blur-xl border-b border-white/10 px-6 py-6 space-y-4 shadow-2xl transition-all duration-200"
    aria-label="Mobile Navigation"
  >
    <nav class="flex flex-col space-y-3">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-nav-event={link.event}
            class="mobile-nav-link text-base font-medium text-slate-300 hover:text-cyan-400 py-2 border-b border-white/5 transition flex items-center justify-between"
            {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          >
            <span>{link.label}</span>
            {link.external && <span class="text-xs font-mono text-slate-500">↗</span>}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  import { trackEvent } from "../utils/analytics";

  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const hamburgerIcon = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");
  const mobileNavLinks = document.querySelectorAll(".mobile-nav-link");

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener("click", () => {
      const isOpen = !mobileMenu.classList.contains("hidden");
      if (isOpen) {
        mobileMenu.classList.add("hidden");
        toggleBtn.setAttribute("aria-expanded", "false");
        hamburgerIcon?.classList.remove("hidden");
        hamburgerIcon?.classList.add("block");
        closeIcon?.classList.remove("block");
        closeIcon?.classList.add("hidden");
      } else {
        mobileMenu.classList.remove("hidden");
        toggleBtn.setAttribute("aria-expanded", "true");
        hamburgerIcon?.classList.remove("block");
        hamburgerIcon?.classList.add("hidden");
        closeIcon?.classList.remove("hidden");
        closeIcon?.classList.add("block");
      }
    });

    mobileNavLinks.forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.add("hidden");
        toggleBtn.setAttribute("aria-expanded", "false");
        hamburgerIcon?.classList.remove("hidden");
        hamburgerIcon?.classList.add("block");
        closeIcon?.classList.remove("block");
        closeIcon?.classList.add("hidden");
      });
    });
  }

  document.querySelectorAll<HTMLElement>("[data-nav-event]").forEach((el) => {
    el.addEventListener("click", () => {
      trackEvent("outbound_click", { target: el.dataset.navEvent });
    });
  });
</script>

---
import JMeterLayout from "../../layouts/JMeterLayout.astro";
import CalculatorWidget from "../../components/CalculatorWidget.astro";
import { calculators } from "../../data/calculators";
import type { Calculator } from "../../data/calculators";
import { siteConfig } from "../../data/products";

export function getStaticPaths() {
  return calculators.map((calculator) => ({
    params: { id: calculator.id },
    props: { calculator },
  }));
}

interface Props {
  calculator: Calculator;
}

const { calculator: calc } = Astro.props;
const others = calculators.filter((c) => c.id !== calc.id);

const title = `${calc.name} — Free Performance Testing Tool`;
const description = `${calc.tagline} Formula: ${calc.formula}. ${calc.explainer[0]}`;
const pageUrl = `${siteConfig.url}/calculators/${calc.id}/`;

const faqSchema = {
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq`,
  mainEntity: calc.faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
  isPartOf: { "@id": `${siteConfig.url}/#website` },
};

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.url },
    { "@type": "ListItem", position: 2, name: "Calculators", item: `${siteConfig.url}/calculators/` },
    { "@type": "ListItem", position: 3, name: calc.name, item: pageUrl },
  ],
};

const appSchema = {
  "@type": "WebApplication",
  name: calc.name,
  url: pageUrl,
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "Performance Testing",
  operatingSystem: "Any (web browser)",
  description,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@id": `${siteConfig.url}/#organization` },
};
---

<JMeterLayout title={title} description={description} jsonLdExtra={[faqSchema, breadcrumbSchema, appSchema]}>
  <main class="px-6 py-12 md:py-16 relative">
    <article class="max-w-4xl mx-auto space-y-10">
      <a href="/calculators/" class="inline-flex items-center gap-2 text-xs font-mono text-slate-400 hover:text-cyan-400 transition">
        ← All Calculators
      </a>

      <header class="space-y-3">
        <p class="text-xs font-mono tracking-widest uppercase" style="color: #ff6b6b;">🧮 PERFTRACTOR</p>
        <h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">
          {calc.emoji} {calc.name}
        </h1>
        <p class="text-slate-400 leading-relaxed">{calc.tagline}</p>
      </header>

      <CalculatorWidget calculator={calc} />

      <section class="glass-panel rounded-xl border border-white/10 p-5 space-y-3">
        <h2 class="text-sm font-mono tracking-widest uppercase" style="color: #ff6b6b;">The Formula</h2>
        <p class="text-lg font-bold text-white font-mono">{calc.formula}</p>
        <ul class="text-sm text-slate-400 space-y-1">
          {calc.formulaTerms.map((t) => (
            <li><strong class="text-slate-200">{t.term}</strong> = {t.meaning}</li>
          ))}
        </ul>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-white">How it works</h2>
        {calc.explainer.map((p) => (
          <p class="text-slate-400 leading-relaxed">{p}</p>
        ))}
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-white">Frequently Asked Questions</h2>
        <div class="space-y-3">
          {calc.faqs.map((faq) => (
            <details class="glass-panel rounded-xl border border-white/10 group">
              <summary class="flex items-center gap-3 px-5 py-4 cursor-pointer list-none select-none text-sm font-semibold text-slate-100">
                {faq.question}
                <span class="ml-auto text-slate-500 text-xs transition-transform group-open:rotate-90" aria-hidden="true">▶</span>
              </summary>
              <p class="px-5 pb-5 text-sm text-slate-400 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <nav class="border-t border-white/10 pt-6 space-y-3">
        <h2 class="text-sm font-mono tracking-widest text-slate-500 uppercase">More calculators</h2>
        <div class="grid gap-3 sm:grid-cols-2">
          {others.map((c) => (
            <a href={`/calculators/${c.id}/`} class="glass-panel rounded-xl border border-white/10 p-3 hover:border-red-400/40 transition text-sm text-slate-300 hover:text-white">
              {c.emoji} {c.name}
            </a>
          ))}
        </div>
      </nav>
    </article>
  </main>
</JMeterLayout>

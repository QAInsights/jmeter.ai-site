---
import JMeterLayout from "../../layouts/JMeterLayout.astro";
import { promptCategories } from "../../data/prompts";
import type { PromptCategory } from "../../data/prompts";
import { siteConfig } from "../../data/products";

export function getStaticPaths() {
  return promptCategories.map((category) => ({
    params: { category: category.id },
    props: { category },
  }));
}

interface Props {
  category: PromptCategory;
}

const { category } = Astro.props;
const others = promptCategories.filter((c) => c.id !== category.id);

const title = `${category.label} | AI Prompts for Performance Engineers`;
const description = `${category.prompts.length} copy-ready AI prompts for ${category.label.toLowerCase()} in JMeter, k6, and Gatling. Part of the JMeter.AI LLM Hub.`;
const pageUrl = `${siteConfig.url}/prompts/${category.id}/`;

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.url },
    { "@type": "ListItem", position: 2, name: "LLM Hub", item: `${siteConfig.url}/prompts/` },
    { "@type": "ListItem", position: 3, name: category.label, item: pageUrl },
  ],
};

const collectionSchema = {
  "@type": "CollectionPage",
  "@id": pageUrl,
  name: title,
  description,
  url: pageUrl,
  isPartOf: { "@id": `${siteConfig.url}/#website` },
};
---

<JMeterLayout title={title} description={description} jsonLdExtra={[breadcrumbSchema, collectionSchema]}>
  <main class="px-6 py-12 md:py-16 relative">
    <article class="max-w-4xl mx-auto space-y-10">
      <a href="/prompts/" class="inline-flex items-center gap-2 text-xs font-mono text-slate-400 hover:text-cyan-400 transition">
        ← All Prompt Categories
      </a>

      <header class="space-y-3">
        <p class="text-xs font-mono tracking-widest text-emerald-400 uppercase">📚 LLM HUB · {category.prompts.length} PROMPTS</p>
        <h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">{category.label}</h1>
        <p class="text-slate-400 leading-relaxed">{description}</p>
      </header>

      <div class="space-y-6">
        {category.prompts.map((prompt) => (
          <section class="glass-panel rounded-xl border border-white/10 overflow-hidden">
            <div class="flex items-center justify-between gap-3 px-5 py-3 border-b border-white/5">
              <h2 class="text-sm font-semibold text-slate-100">{prompt.title}</h2>
              <button
                class="copy-prompt shrink-0 text-[10px] font-mono px-2.5 py-1 rounded border border-emerald-400/40 text-emerald-300 hover:bg-emerald-400/10 transition"
                data-prompt-id={prompt.id}
              >Copy</button>
            </div>
            <pre id={`prompt-${prompt.id}`} class="px-5 py-4 text-xs text-slate-300 leading-relaxed whitespace-pre-wrap font-mono overflow-x-auto">{prompt.body}</pre>
          </section>
        ))}
      </div>

      <nav class="border-t border-white/10 pt-6 space-y-3">
        <h2 class="text-sm font-mono tracking-widest text-slate-500 uppercase">More categories</h2>
        <div class="grid gap-2 sm:grid-cols-2">
          {others.slice(0, 8).map((c) => (
            <a href={`/prompts/${c.id}/`} class="text-sm text-slate-400 hover:text-emerald-300 transition">
              {c.label} <span class="text-slate-600 font-mono text-xs">({c.prompts.length})</span>
            </a>
          ))}
        </div>
      </nav>
    </article>
  </main>

  <script>
    document.querySelectorAll<HTMLButtonElement>(".copy-prompt").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const el = document.getElementById(`prompt-${btn.dataset.promptId}`);
        if (!el) return;
        await navigator.clipboard.writeText(el.textContent ?? "");
        const original = btn.textContent;
        btn.textContent = "Copied!";
        setTimeout(() => { btn.textContent = original; }, 1500);
      });
    });
  </script>
</JMeterLayout>

---
import JMeterLayout from "../../layouts/JMeterLayout.astro";
import { promptCategories } from "../../data/prompts";
import { siteConfig } from "../../data/products";

const totalPrompts = promptCategories.reduce((n, c) => n + c.prompts.length, 0);

const title = "AI Prompts for Performance Engineers — LLM Hub";
const description = `${totalPrompts}+ copy-ready AI prompts for JMeter, k6, Gatling, and performance engineering: test planning, script generation, correlation, CI/CD, results analysis, and more.`;

const itemListSchema = {
  "@type": "ItemList",
  itemListElement: promptCategories.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.label,
    url: `${siteConfig.url}/prompts/${c.id}/`,
  })),
};

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.url },
    { "@type": "ListItem", position: 2, name: "LLM Hub", item: `${siteConfig.url}/prompts/` },
  ],
};
---

<JMeterLayout title={title} description={description} jsonLdExtra={[itemListSchema, breadcrumbSchema]}>
  <main class="px-6 py-12 md:py-16 relative">
    <div class="max-w-7xl mx-auto space-y-10">
      <a href="/products/prompts/" class="inline-flex items-center gap-2 text-xs font-mono text-slate-400 hover:text-cyan-400 transition">
        ← Back to LLM Hub
      </a>

      <header class="space-y-3">
        <p class="text-xs font-mono tracking-widest text-emerald-400 uppercase">📚 LLM HUB</p>
        <h1 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight">
          AI Prompts for <span class="text-emerald-400">Performance Engineers</span>
        </h1>
        <p class="text-slate-400 leading-relaxed max-w-3xl">{description}</p>
      </header>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {promptCategories.map((c) => (
          <a href={`/prompts/${c.id}/`} class="glass-panel rounded-xl border border-white/10 p-4 hover:border-emerald-400/40 transition group">
            <div class="flex items-center justify-between gap-2">
              <span class="font-semibold text-slate-100 group-hover:text-white text-sm">{c.label}</span>
              <span class="text-[10px] font-mono text-emerald-300 shrink-0">{c.prompts.length} prompts</span>
            </div>
            <p class="mt-1.5 text-xs text-slate-500">{c.prompts[0]?.title}</p>
          </a>
        ))}
      </div>
    </div>
  </main>
</JMeterLayout>

---
import JMeterLayout from "../layouts/JMeterLayout.astro";
import { Show } from "@clerk/astro/components";
import { SignIn } from "@clerk/astro/components";
import { UserProfile } from "@clerk/astro/components";
---

<JMeterLayout title="Settings" description="User account settings and profile management for JMeter.AI">
  <main class="px-6 py-16 min-h-[70vh]">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl font-bold text-white tracking-tight mb-8">Settings</h1>

      <Show when="signed-out">
        <div class="glass-panel rounded-2xl p-8 text-center">
          <p class="text-slate-400 mb-6 font-mono text-sm">
            Please sign in to access settings.
          </p>
          <SignIn
            routing="hash"
            signUpUrl="/settings"
            appearance={{
              elements: {
                rootBox: "mx-auto",
                card: "bg-graph-bg border border-white/10 shadow-none",
                headerTitle: "text-white font-mono",
                headerSubtitle: "text-slate-400 font-mono text-xs",
                formButtonPrimary: "bg-cyan-500 text-slate-950 font-mono hover:opacity-90",
                formFieldLabel: "text-slate-200 font-mono text-xs",
                formFieldInput: "bg-graph-card border-white/10 text-slate-200 font-mono",
                footerActionLink: "text-cyan-400 font-mono",
                socialButtonsBlockButton: "border-white/10 text-slate-200 font-mono hover:bg-white/5",
                dividerLine: "bg-white/10",
                dividerText: "text-slate-400 font-mono text-xs",
              },
            }}
          />
        </div>
      </Show>

      <Show when="signed-in">
        <div class="space-y-6">
          <section class="glass-panel rounded-2xl p-8">
            <h2 class="text-lg font-semibold text-white mb-4 font-mono text-sm">
              Profile
            </h2>
            <p class="text-slate-400 font-mono text-xs">
              Profile settings coming soon.
            </p>
          </section>

          <section class="glass-panel rounded-2xl p-8">
            <h2 class="text-lg font-semibold text-white mb-4 font-mono text-sm">
              Preferences
            </h2>
            <p class="text-slate-400 font-mono text-xs">
              Preference settings coming soon.
            </p>
          </section>

          <section class="glass-panel rounded-2xl p-8">
            <h2 class="text-lg font-semibold text-white mb-4 font-mono text-sm">
              Account
            </h2>
            <p class="text-slate-400 font-mono text-xs">
              Account settings coming soon.
            </p>
          </section>
        </div>
      </Show>
    </div>
  </main>
</JMeterLayout>

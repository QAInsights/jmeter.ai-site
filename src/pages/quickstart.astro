---
import JMeterLayout from "../layouts/JMeterLayout.astro";
import { installMethods } from "../data/products";

const steps = [
  "Install Apache JMeter 5.6.3+ on Java 17+ from the official download page if you don't have it yet.",
  "Pick one of the three install methods below.",
  "After installation, open Feather Wand with the toolbar wand button, Ctrl+Shift+A (⌘⇧A on macOS), or Run → AI.",
  "Click Connect a provider on the welcome screen, or ⋯ → Connect a provider….",
  "Pick a provider. For API-key providers, paste an API key; use Get a key where available. Ollama and Apple on-device need no key. OpenCode is a CLI option using free models or credentials managed by its CLI, with no API-key field in Feather Wand.",
  "Click Test connection, then Save and connect (Use Apple on-device for Apple). Pick a model and use Chat immediately—no restart needed. Agent Mode requires a supported provider; Ollama, AWS Bedrock, and Apple on-device are chat-only.",
];

const jsonLdExtra = [
  {
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "How do I install Feather Wand for JMeter?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "The easiest way is the JMeter Plugins Manager: Options → Plugins Manager → Available Plugins → search \"Feather Wand\" → Apply Changes and Restart JMeter. For CI, use the Plugins Manager CLI: bin/PluginsManagerCMD.sh install feather-wand-jmeter-ai-agent, then configure the provider in bin/user.properties before starting JMeter. For GUI setup, open Feather Wand with the toolbar wand button, Ctrl+Shift+A (⌘⇧A on macOS), or Run → AI, then click Connect a provider on the welcome screen.",
        },
      },
      {
        "@type": "Question",
        name: "What do I need before installing?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Apache JMeter 5.6.3+ on Java 17+ is required. The plugin runs inside JMeter, so you need a JMeter installation first.",
        },
      },
      {
        "@type": "Question",
        name: "How do I configure an LLM provider?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Click Connect a provider on the welcome screen or ⋯ → Connect a provider…. Pick a provider; for API-key providers, paste an API key (Get a key where available), click Test connection, then Save and connect. Ollama and Apple on-device need no key; Apple uses Use Apple on-device on supported Macs. OpenCode is a CLI option using free models or credentials managed by its CLI, with no API-key field in Feather Wand. Settings are saved to bin/user.properties for you; Chat works immediately without restarting. Agent Mode requires a supported provider; Ollama, AWS Bedrock, and Apple on-device are chat-only. Manual properties remain supported but require a restart; AWS Bedrock and corporate gateways are properties-only. The JSR223 refactor menu picks up a new provider after restart.",
        },
      },
    ],
  },
];
---

<JMeterLayout
  title="Quickstart | Install & Configure JMeter.AI"
  description="Get Feather Wand running in Apache JMeter in five minutes: install the plugin and connect a provider in the UI, without a configuration restart."
  jsonLdExtra={jsonLdExtra}
>
  <main class="px-6 py-12 md:py-16">
    <div class="max-w-4xl mx-auto space-y-12">
      <section class="space-y-4">
        <p class="text-xs font-mono tracking-widest text-cyan-400 uppercase">⚡ Quickstart</p>
        <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white">
          Install <span class="gradient-text">JMeter.AI</span> in 5 minutes
        </h1>
        <p class="text-slate-400 leading-relaxed max-w-2xl">
          Feather Wand is an AI agent that lives inside Apache JMeter. Install it with the
          Plugins Manager, CLI, or a release JAR, then connect a provider in the panel.
        </p>

        <ol class="space-y-2 list-decimal list-inside text-slate-300 text-sm">
          {
            steps.map((step) => (
              <li class="text-slate-400">
                <span class="text-slate-200">{step}</span>
              </li>
            ))
          }
        </ol>
        <p class="text-slate-400 text-sm leading-relaxed mt-4">
          Settings are saved to JMeter's bin/user.properties for you (or your configured user.properties path).
          Apple on-device appears only on supported Macs. The JSR223 refactor menu picks up a new provider after restart.
        </p>
        <p class="text-slate-400 text-sm leading-relaxed">
          <strong class="text-slate-200">Prefer properties?</strong> Append the
          <a class="text-cyan-300 underline" href="https://github.com/QAInsights/jmeter-ai/blob/main/jmeter-ai-quickstart.properties">quick-start file</a>
          to bin/user.properties, preserving existing settings, then uncomment one provider and add its key.
          Restart JMeter after manual edits. AWS Bedrock and corporate gateways are properties-only.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-white tracking-tight">Install methods</h2>
        {
          installMethods.map((method) => (
            <div class="glass-panel rounded-2xl border border-white/10 p-6 space-y-4">
              <div>
                <h3 class="text-lg font-bold text-white">{method.label}</h3>
                <p class="text-sm text-slate-400">{method.description}</p>
              </div>
              {method.blocks.map((block) => (
                <div class="space-y-1.5">
                  <div class="text-xs font-mono text-slate-500 uppercase tracking-wider">{block.title}</div>
                  <pre class="bg-black/50 rounded-xl p-4 font-mono text-xs text-slate-300 border border-white/5 whitespace-pre-wrap break-all leading-relaxed">{block.code}</pre>
                </div>
              ))}
            </div>
          ))
        }
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-white tracking-tight">First prompt to try</h2>
        <div class="glass-panel rounded-2xl border border-cyan-500/30 p-6">
          <p class="text-slate-400 text-sm leading-relaxed">
            Once connected, pick your model in Feather Wand and ask something like:
          </p>
          <blockquote class="mt-3 font-mono text-cyan-300 text-sm border-l-2 border-cyan-500/40 pl-4">
            "Generate a JMX test plan with 50 virtual users, a ramp-up of 30 seconds, and assertions on the
            response time."
          </blockquote>
          <p class="text-xs text-slate-500 mt-4">
            Agent Mode is on by default, so the AI edits the plan directly. Switch to Chat under the message box any
            time you just want answers.
          </p>
        </div>
      </section>
    </div>
  </main>
</JMeterLayout>
